parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
        - tools/
    excludePaths:
        analyseAndScan:
            - tests/Fixtures/Architecture/
            - tests/Fixtures/PHPStan/

services:
    -
        class: Tools\PHPStan\Rules\InvokableControllerRule
        tags: [phpstan.rules.rule]
    -
        class: Tools\PHPStan\Rules\EntityCollectionRule
        tags: [phpstan.rules.rule]
